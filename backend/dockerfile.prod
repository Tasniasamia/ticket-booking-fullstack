# Build the Go API as a static Linux binary.
FROM golang:1.26.9-alpine AS builder

WORKDIR /src
RUN apk add --no-cache ca-certificates git

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" -o /out/ticket-booking ./cmd/main.go

# Small runtime image for Render's Docker-based Web Service.
FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S app && adduser -S -G app app

WORKDIR /app
COPY --from=builder /out/ticket-booking ./ticket-booking

ENV APP_ENV=production
EXPOSE 1323
USER app

# Render injects PORT at runtime; the Go app reads it from the environment.
ENTRYPOINT ["/app/ticket-booking"]
